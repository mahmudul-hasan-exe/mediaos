# =========================================================================
# MediaOS Monorepo — Root .gitignore (Backend: Laravel | Frontend: Next.js)
# =========================================================================

# macOS / OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# Environment & Secrets (Never commit real .env files; keep .env.example)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
/backend/vendor/
/backend/node_modules/
/frontend/node_modules/
**/node_modules/

# Build & Framework Caches
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/pail
/backend/.phpunit.cache
/backend/.phpunit.result.cache
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/
**/*.tsbuildinfo
/frontend/next-env.d.ts

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / IDE local folders
.idea/
.vscode/
.cursor/
.zed/
.codex/
.vercel/
